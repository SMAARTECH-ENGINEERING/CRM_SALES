# ---------------------------------------------------------------
# CRM API - environment variables
# Copy to .env (or run `npm run setup:env`) and fill in the values.
# Never commit the real .env file.
# ---------------------------------------------------------------

# Runtime: development | test | production
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/crm

# JWT - each secret must be at least 32 random characters.
# `npm run setup:env` generates these for you.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing cost
BCRYPT_SALT_ROUNDS=12

# Whether POST /auth/register is open to anyone.
# Leave empty for the default: true outside production, false in production.
# When false, only a signed-in admin can register users.
ALLOW_PUBLIC_REGISTRATION=

# Failed login attempts allowed per IP per window
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Company codes are generated as <PREFIX>-<zero-padded number>, e.g. COMP-000001.
# Prefix: 1-10 uppercase letters/digits. Changing these affects new companies only.
COMPANY_CODE_PREFIX=COMP
COMPANY_CODE_DIGITS=6

# Lead and opportunity numbers, generated the same way: LEAD-000001, OPP-000001.
LEAD_NUMBER_PREFIX=LEAD
LEAD_NUMBER_DIGITS=6
OPPORTUNITY_NUMBER_PREFIX=OPP
OPPORTUNITY_NUMBER_DIGITS=6

# Generated quotation numbers: <PREFIX>-<number padded to DIGITS>
QUOTATION_NUMBER_PREFIX=QUO
QUOTATION_NUMBER_DIGITS=6

# Generated order numbers: <PREFIX>-<number padded to DIGITS>
ORDER_NUMBER_PREFIX=ORD
ORDER_NUMBER_DIGITS=6

# Generated customer numbers: <PREFIX>-<number padded to DIGITS>
CUSTOMER_NUMBER_PREFIX=CUST
CUSTOMER_NUMBER_DIGITS=6

# Generated project numbers: <PREFIX>-<number padded to DIGITS>
PROJECT_NUMBER_PREFIX=PRJ
PROJECT_NUMBER_DIGITS=6

# Generated ticket numbers: <PREFIX>-<number padded to DIGITS>
TICKET_NUMBER_PREFIX=TKT
TICKET_NUMBER_DIGITS=6

# The audit log records every change (who, what, from where). Keep it on.
AUDIT_ENABLED=true

# The most rows a report export (CSV, Excel, PDF) may hold. A report with more rows is exported
# up to this many, and says so.
REPORT_EXPORT_MAX_ROWS=10000

# How often (minutes) the server checks for follow-ups that have come due and payments that
# have become overdue, and notifies the people responsible. 0 switches the check off.
# (Real-time delivery uses Socket.IO on the same port as the API; the browser origin must be
# listed in CORS_ORIGIN.)
NOTIFICATION_CHECK_INTERVAL_MINUTES=15

# Generated invoice numbers (when none is entered): <PREFIX>-<number padded to DIGITS>
INVOICE_NUMBER_PREFIX=INV
INVOICE_NUMBER_DIGITS=6
# false: the amount paid can never be more than the invoice amount, and the invoices of an
# order can never add up to more than the order total. Set to true only if you take
# overpayments / advances.
PAYMENT_ALLOW_OVERPAYMENT=false

# Generated contract numbers: <PREFIX>-<number padded to DIGITS>
CONTRACT_NUMBER_PREFIX=CON
CONTRACT_NUMBER_DIGITS=6
# How often (minutes) the server checks for contract expiry reminders and marks ended
# contracts expired. 0 switches the automatic check off. WHEN reminders go out (how many
# days before the end date) is not set here: manage it in Settings -> Contract reminder periods.
CONTRACT_REMINDER_INTERVAL_MINUTES=60

# Where uploaded files (documents, ticket attachments) are kept. Files are never stored in
# MongoDB - only their details.
#   s3     an S3-compatible object store (AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces).
#          Use this in production.
#   local  the UPLOAD_DIR folder on this server. For development.
STORAGE_DRIVER=local
# For STORAGE_DRIVER=s3. The bucket must exist and stay PRIVATE: files are only ever served
# through the API, to signed-in users.
S3_BUCKET=
S3_REGION=us-east-1
# Only for stores other than AWS, e.g. http://localhost:9000 for MinIO (then also S3_FORCE_PATH_STYLE=true).
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Leave both empty to use the machine's own credentials (an IAM role, for example).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, e.g. crm/production
S3_KEY_PREFIX=

# Ticket attachments. Files are stored on the server under UPLOAD_DIR (relative to the
# server folder) and are only downloaded through the API, by signed-in users.
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_FILES=5
# Comma-separated MIME types; image/* allows every image type. Default: images, PDF,
# text, CSV, ZIP, Word and Excel.
# UPLOAD_ALLOWED_TYPES=image/*,application/pdf,text/plain

# Outgoing email for "Send quotation". Leave it all empty to email nothing:
# sending then only marks the quotation as sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com and
# SMTP_PASS=a 16-character App Password (Google Account > Security > App
# passwords; needs 2-Step Verification). Your normal password is refused.
# Check the settings with: npm run mail:check
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Alternative to the four above, as one URL. A user name containing "@" must be
# written %40, e.g. smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
# Sender address; defaults to the company profile's email, then SMTP_USER.
MAIL_FROM=

# Product SKUs are generated as <PREFIX>-<number> when none is supplied. The
# prefix comes from the product's category if it has one, otherwise from here.
PRODUCT_SKU_PREFIX=PRD
PRODUCT_SKU_DIGITS=6

# Duplicate prevention on lead conversion. Before a company or contact is
# created, existing records are searched on these fields, in this order; the
# first match is linked instead of creating a new record.
#   Company fields: gstNumber, panNumber, email, phone, website, name
#   Contact fields: email, phone, alternatePhone, name   (within the same company)
COMPANY_MATCH_FIELDS=gstNumber,email,name
CONTACT_MATCH_FIELDS=email,phone

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Rate limiting (per IP)
# false switches rate limiting off entirely (all requests and failed sign-ins).
# Keep it true in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Number of reverse proxies in front of the API (0 when none)
TRUST_PROXY=0

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
