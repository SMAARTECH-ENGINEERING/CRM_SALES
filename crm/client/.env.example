# ---------------------------------------------------------------
# CRM client - environment variables
# Copy to .env. Only VITE_-prefixed variables reach the browser,
# and everything here is public - never put secrets in this file.
# ---------------------------------------------------------------

# Base URL of the CRM API, including the version prefix
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Name shown in the app bar and browser tab
VITE_APP_NAME=CRM

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Dev server port (must match CORS_ORIGIN in server/.env)
VITE_DEV_PORT=5173
